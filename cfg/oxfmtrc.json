{
  "$schema": "../node_modules/oxfmt/configuration_schema.json",
  "sortImports": true,
  "jsdoc": {
    "commentLineStrategy": "keep",
    "lineWrappingStyle": "balance",
    "capitalizeDescriptions": false
  },
  "overrides": [
    {
      "files": ["**/*.md"],
      "options": {
        "tabWidth": 4
      }
    }
  ]
}
