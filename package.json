{
  "name": "@fal-works/lint-js-global",
  "version": "0.1.0",
  "description": "Globally-installed CLI that runs Oxfmt and Oxlint with type-aware linting.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fal-works/lint-js-global.git"
  },
  "bin": {
    "lint-js": "src/cli.js"
  },
  "files": [
    "src",
    "cfg",
    "docs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "node src/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/cli/*.test.js",
    "prepublishOnly": "pnpm lint --check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "oxlint-tsgolint": "^0.20.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
