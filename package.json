{
  "name": "@fal-works/lint-js-global",
  "version": "0.2.0",
  "description": "Globally-installed CLI that runs Oxfmt and Oxlint with type-aware linting.",
  "keywords": [
    "format",
    "lint",
    "oxfmt",
    "oxlint"
  ],
  "license": "Apache-2.0",
  "author": "FAL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fal-works/lint-js-global.git"
  },
  "bin": {
    "lint-js": "dist/bin.js"
  },
  "files": [
    "dist",
    "cfg",
    "docs/guide"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "node src/bin.ts",
    "test": "node --test --test-reporter=dot 'src/**/*.test.ts' 'test/integration/*.test.ts' 'test/cli/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "clean": "node scripts/clean.ts",
    "prepack": "pnpm clean && pnpm build",
    "smoke:publish": "node --test --test-isolation=none test/publish-smoke/*.test.ts",
    "prepublishOnly": "pnpm audit && pnpm lint --check && pnpm test && pnpm smoke:publish"
  },
  "dependencies": {
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
